{
  "name": "quefaltasoria",
  "version": "1.0.0",
  "description": "QueFalta Soria - Comparador de precios y listas de la compra para supermercados en Soria",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "tsx src/db/seed.ts",
    "import:all": "tsx src/scrapers/importAll.ts",
    "sync:feeds": "tsx src/scrapers/syncQueFaltaFeeds.ts",
    "scrape:mercadona": "tsx src/scrapers/runMercadona.ts",
    "scrape:dia": "tsx src/scrapers/runDia.ts",
    "scrape:all": "tsx src/scrapers/runAll.ts"
  },
  "keywords": [
    "soria",
    "supermercados",
    "quefalta",
    "precios",
    "comparador"
  ],
  "author": "Gabi",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
